@using Aiursoft.MarkToHtml.Controllers
@using Aiursoft.MarkToHtml.Authorization
@using Microsoft.AspNetCore.Authorization
@model Aiursoft.MarkToHtml.Models.AdminViewModels.EditDocumentViewModel
@inject IAuthorizationService AuthorizationService
@{
    var canDeleteAnyDocument = (await AuthorizationService.AuthorizeAsync(User, AppPermissionNames.CanDeleteAnyDocument)).Succeeded;
    var canManageAnyShare = (await AuthorizationService.AuthorizeAsync(User, AppPermissionNames.CanManageAnyShare)).Succeeded;
    var isDarkMode = Context.Request.Cookies[ThemeController.ThemeCookieKey] == true.ToString();
}

@if (Model.SavedSuccessfully)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        <div class="alert-icon">
            <i class="align-middle" data-lucide="alert-triangle"></i>
        </div>
        <div class="alert-message">
            <strong>@Localizer["Success!"]</strong>
            @Localizer["Document updated successfully."]
        </div>
    </div>
}

<div class="row mb-2 mb-xl-3">
    <div class="col-auto d-none d-sm-block">
        <h3>@Localizer["Edit Document"]</h3>
        <p class="mb-0 text-muted">@Localizer["Modify document content, title, and owner."]</p>
    </div>
    <div class="col-auto ms-auto text-end mt-n1">
        @if (canManageAnyShare)
        {
            <a asp-controller="Home" asp-action="ManageShares" asp-route-id="@Model.DocumentId" class="btn btn-outline-info me-1">
                <i class="align-middle" data-lucide="share-2"></i> @Localizer["Manage Shares"]
            </a>
        }
        @if (canDeleteAnyDocument)
        {
            <a asp-action="DeleteDocument" asp-route-id="@Model.DocumentId" class="btn btn-danger">
                <i class="align-middle" data-lucide="trash-2"></i> @Localizer["Delete"]
            </a>
        }
    </div>
</div>

<form asp-action="EditDocument" method="post" id="markdown-form">
    <input type="hidden" asp-for="DocumentId" />

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="align-middle" data-lucide="file-pen-line">&nbsp;</i>
                @Localizer["Document Details"]
            </h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Title" class="form-label">@Localizer["Document Title (optional)"]</label>
                <input asp-for="Title" class="form-control form-control-lg" placeholder="@Localizer["Enter the document title"]" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SelectedUserId" class="form-label"></label>
                <select asp-for="SelectedUserId" asp-items="@Model.AllUsers" class="form-select form-select-lg">
                    <option value="">@Localizer["-- Select an Owner --"]</option>
                </select>
                <span asp-validation-for="SelectedUserId" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
                <i class="align-middle" data-lucide="code-2">&nbsp;</i>
                @Localizer["Markdown Content"]
            </h5>
            <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
                <input type="radio" class="btn-check" name="view-mode" id="view-split" value="split" autocomplete="off" checked>
                <label class="btn btn-outline-secondary" for="view-split" title="@Localizer["Split View"]"><i class="align-middle" data-lucide="columns"></i></label>

                <input type="radio" class="btn-check" name="view-mode" id="view-editor" value="editor" autocomplete="off">
                <label class="btn btn-outline-secondary" for="view-editor" title="@Localizer["Editor Only"]"><i class="align-middle" data-lucide="code-2"></i></label>

                <input type="radio" class="btn-check" name="view-mode" id="view-preview" value="preview" autocomplete="off">
                <label class="btn btn-outline-secondary" for="view-preview" title="@Localizer["Preview Only"]"><i class="align-middle" data-lucide="eye"></i></label>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="row g-0" style="min-height: 60vh;">
                <div id="editor-column" class="col-md-6 border-end">
                    <div class="position-relative" style="height: 100%; min-height: 60vh;">
                        <div id="markdown-editor-container" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;"></div>
                        <textarea asp-for="InputMarkdown" id="markdown-editor" class="form-control" rows="20"></textarea>
                    </div>
                </div>
                <div id="preview-column" class="col-md-6 overflow-auto bg-light-subtle">
                    <div id="preview-content" class="markdown-content p-4" style="min-height: 60vh;"></div>
                </div>
            </div>
        </div>
        <span asp-validation-for="InputMarkdown" class="text-danger px-3"></span>
    </div>

    <div class="row mt-3">
        <div class="col text-center">
            <a asp-action="AllDocuments" class="btn btn-outline-secondary btn-lg me-2">
                <i class="align-middle" data-lucide="arrow-left">&nbsp;</i>
                @Localizer["Back to List"]
            </a>

            <button type="submit" class="btn btn-primary btn-lg">
                <i class="align-middle" data-lucide="save">&nbsp;</i>
                @Localizer["Save Changes"]
            </button>
        </div>
    </div>
</form>

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/node_modules/@@fontsource/cascadia-code/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/styles/markdown-reader.css" asp-append-version="true" />
    @if (isDarkMode)
    {
        <link rel="stylesheet" href="~/node_modules/@@highlightjs/cdn-assets/styles/github-dark.min.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/node_modules/@@highlightjs/cdn-assets/styles/github.min.css" asp-append-version="true" />
    }
    <style>
        main.content {
            padding: 0 !important;
        }
        @@media (max-width: 767.98px) {
            #editor-column,
            #preview-column {
                width: 100%;
                display: none;
            }
            .view-mode-editor #editor-column,
            .view-mode-preview #preview-column {
                display: block;
            }
        }
    </style>
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    @* markdown-it, mermaid, hljs MUST be loaded before Monaco's loader.js *@
    <script src="~/node_modules/@@aiursoft/uistack-markdown-ui/dist/index.global.js" asp-append-version="true"></script>
    <script src="~/node_modules/mermaid/dist/mermaid.min.js" asp-append-version="true"></script>
    <script src="~/node_modules/@@highlightjs/cdn-assets/highlight.min.js" asp-append-version="true"></script>
    <script>var require = { paths: { 'vs': '/node_modules/monaco-editor/min/vs' } };</script>
    <script src="~/node_modules/monaco-editor/min/vs/loader.js" asp-append-version="true"></script>
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']],
            },
            svg: {
                fontCache: 'global'
            }
        };
    </script>
    <script id="MathJax-script" defer src="~/node_modules/mathjax/es5/tex-mml-chtml.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            if ($.validator) {
                $.validator.setDefaults({
                    ignore: []
                });
            }

                let markdownEditorInstance;
                let markdownEditorController;
                const markdownEditorElement = document.getElementById('markdown-editor');
                const monacoTheme = '@(isDarkMode ? "vs-dark" : "vs")';

                if (markdownEditorElement) {
                    markdownEditorController = await window.AiursoftMarkdownUi.createMarkdownEditor({
                        editorContainer: document.getElementById('markdown-editor-container'),
                        textarea: markdownEditorElement,
                        previewContainer: document.getElementById('preview-content'),
                        editorPane: document.getElementById('editor-column'),
                        previewPane: document.getElementById('preview-column'),
                        form: document.getElementById('markdown-form'),
                        loadMonaco: function () { return window.AiursoftMarkdownUi.loadMonacoFromAmd(); },
                        theme: monacoTheme,
                        initialViewMode: 'split',
                        viewModeStorageKey: 'admin-markdown-view-mode',
                        uploadUrl: '/Storage/Upload?container=markdown-images',
                        mermaidTheme: '@(isDarkMode ? "dark" : "default")',
                        editorOptions: {
                            'semanticHighlighting.enabled': true,
                            fontFamily: "'Cascadia Code', 'Consolas', 'Courier New', monospace",
                            fontSize: 14,
                            fontLigatures: true
                        },
                        onInitializationError: function (error) {
                            console.error('Markdown editor initialization error:', error);
                        },
                        onPreviewError: function (error) {
                            console.error('Markdown preview error:', error);
                        }
                    });
                    markdownEditorInstance = markdownEditorController.editor;
                }


                // --- View Mode Switcher ---
                const editorCol = document.getElementById('editor-column');
                const previewCol = document.getElementById('preview-column');
                const formRoot = document.getElementById('markdown-form');
                const radios = document.querySelectorAll('input[name="view-mode"]');

                function setViewMode(mode) {
                    if (!editorCol || !previewCol || !formRoot) return;
                    localStorage.setItem('admin-markdown-view-mode', mode);
                    if (markdownEditorController) {
                        void markdownEditorController.setViewMode(mode);
                    }

                    const radio = document.querySelector('input[name="view-mode"][value="' + mode + '"]');
                    if (radio) radio.checked = true;

                    formRoot.classList.remove('view-mode-editor', 'view-mode-preview');

                    if (window.innerWidth >= 768) {
                        if (mode === 'split') {
                            editorCol.classList.remove('d-none', 'col-md-12');
                            editorCol.classList.add('col-md-6');
                            previewCol.classList.remove('d-none', 'col-md-12');
                            previewCol.classList.add('col-md-6');
                        } else if (mode === 'editor') {
                            editorCol.classList.remove('d-none', 'col-md-6');
                            editorCol.classList.add('col-md-12');
                            previewCol.classList.add('d-none');
                        } else if (mode === 'preview') {
                            editorCol.classList.add('d-none');
                            previewCol.classList.remove('d-none', 'col-md-6');
                            previewCol.classList.add('col-md-12');
                        }
                    } else {
                        formRoot.classList.add('view-mode-' + mode);
                    }

                }

                radios.forEach(function(r) {
                    r.addEventListener('change', function(e) { setViewMode(e.target.value); });
                });

                var savedMode = localStorage.getItem('admin-markdown-view-mode') || 'split';
                setViewMode(savedMode);

        });
    </script>
}
